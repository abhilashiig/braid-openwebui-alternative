DATABASE_URL=postgres://localhost:5432/braid_development
# 32 random bytes, base64. Generate with: openssl rand -base64 32. Losing it makes stored provider keys unreadable.
BRAID_MASTER_KEY=
# Public URL used in invite and reset links.
BRAID_PUBLIC_URL=http://localhost:5173
BRAID_BIND=127.0.0.1:3000
# Optional fixed first-run setup token; otherwise a random one is printed to the logs.
BRAID_SETUP_TOKEN=
# Set when behind a reverse proxy so X-Forwarded-For is used for client IPs.
BRAID_TRUST_PROXY=false
# json (default) or pretty
BRAID_LOG_FORMAT=pretty
